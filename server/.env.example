# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local or 'memory' for embedded in-memory MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/findit

# JWT Secrets
JWT_SECRET=supersecret_jwt_key_campus_lost_and_found_2026_dev
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional - leaves local upload fallback if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
