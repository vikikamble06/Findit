# Root Environment Example for FindIt

# -----------------
# BACKEND (server/.env)
# -----------------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or use 'memory' for embedded zero-dependency local demo/testing)
MONGODB_URI=mongodb://127.0.0.1:27017/findit

# JWT Secrets
JWT_SECRET=supersecret_jwt_key_campus_lost_and_found_2026_dev
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Optional Cloudinary Credentials (if left empty, falls back to local server/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# -----------------
# FRONTEND (client/.env)
# -----------------
# Leave empty during local dev (Vite proxy forwards /api to localhost:5000)
# In production on Render/Vercel, set to your backend Render URL:
# VITE_API_URL=https://findit-api.onrender.com
VITE_API_URL=
